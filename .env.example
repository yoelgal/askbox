# Demo mode: both surfaces run outside Fanvue with a seeded creator and a fake
# payment sheet. Turn off in production.
ASKBOX_DEV=true

# Postgres (Neon's pooled URL works)
DATABASE_URL=

# From the Fanvue Builder (App Store > Builder > your app)
FANVUE_APP_UUID=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Must exactly match a redirect registered in the Builder (never visited)
OAUTH_REDIRECT_URI=https://your-host/oauth/callback
OAUTH_SCOPES="openid offline_access offline read:self read:experience write:experience write:chat read:fan"
# Signing secret from the Builder's Events tab
FANVUE_WEBHOOK_SECRET=

# openssl rand -base64 36
SESSION_SECRET=
# openssl rand -base64 32 (encrypts stored refresh tokens)
FANVUE_TOKEN_ENC_KEY=

# Screening and drafting, over any Anthropic-compatible Messages API
# (DeepSeek, OpenRouter, Anthropic).
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/anthropic
AI_MODEL=deepseek-flash

# Password for the /demo walkthrough (creator + fan views, simulated payments)
DEMO_PASSWORD=
